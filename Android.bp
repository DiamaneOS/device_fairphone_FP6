// The QCA6750 host driver requests its configuration through the kernel
// firmware loader, at the path the stock vendor image links. Stock also links
// wlan_mac.bin to /mnt/vendor/persist; here imeiprovd writes that file at boot
// and ueventd serves it from /mnt/vendor/wlan_mac (boot/ueventd.rc), so no
// link is installed.
install_symlink {
    name: "fp6_wlan_cfg_ini",
    vendor: true,
    installed_location: "firmware/wlan/qca_cld/qca6750/WCNSS_qcom_cfg.ini",
    symlink_target: "/vendor/etc/wifi/qca6750/WCNSS_qcom_cfg.ini",
}

// The stock fingerprint module is installed under its own SONAME
// (libfingerprint.default.so). hw_get_module("fingerprint") with
// ro.hardware.fingerprint=fp6 opens this link.
install_symlink {
    name: "fp6_fingerprint_hw_module",
    vendor: true,
    installed_location: "lib64/hw/fingerprint.fp6.so",
    symlink_target: "libfingerprint.default.so",
}

// Display configuration of the built-in panel: the measured brightness table,
// the manual range and the high-brightness limits. The display HAL reports its
// own display ID, so the framework finds the file through the port-based name
// (port 130).
prebuilt_etc {
    name: "fp6_displayconfig_port130",
    vendor: true,
    src: "display/display_port_130.xml",
    sub_dir: "displayconfig",
    filename: "display_port_130.xml",
}
