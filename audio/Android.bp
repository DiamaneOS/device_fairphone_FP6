// The amplifier driver requests the factory calibration through firmware_class.
// Keep the device's own calibration in persist; never package another unit's data.
install_symlink {
    name: "fp6_audio_amplifier_calibration_link",
    vendor: true,
    installed_location: "firmware/aw_cali.bin",
    symlink_target: "/mnt/vendor/persist/factory/audio/aw_cali.bin",
}

// Userdebug and eng only (PRODUCT_PACKAGES_DEBUG in audio.mk): agmcap's backend
// formats, for capturing the microphones past Android in tests.
prebuilt_etc {
    name: "fp6_agm_backend_conf",
    vendor: true,
    src: "backend_conf.xml",
    filename: "backend_conf.xml",
}
