// Bluetooth HCI service: registers the stock Qualcomm HCI implementation
// (selected stock vendor file) through HIDL passthrough, without the FM, ANT,
// SAR, config-store and TPI libraries the stock service links (service.cpp).
// init.fp6.bluetooth.rc starts it; manifest.xml declares IBluetoothHci 1.1.
cc_binary {
    name: "android.hardware.bluetooth@1.1-service.fp6",
    vendor: true,
    relative_install_path: "hw",
    srcs: ["service.cpp"],
    shared_libs: [
        "android.hardware.bluetooth@1.0",
        "android.hardware.bluetooth@1.1",
        "libcutils",
        "libhidlbase",
        "liblog",
        "libutils",
    ],
    // The stock service was built with CFI.
    sanitize: {
        cfi: true,
        integer_overflow: true,
    },
    cflags: [
        "-Wall",
        "-Werror",
        "-Wextra",
    ],
}
