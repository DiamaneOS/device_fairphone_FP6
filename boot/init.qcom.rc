# Initial hardware setup for the pinned FP6 kernel and selected vendor services.

on early-init
    symlink /vendor/firmware_mnt /firmware
    symlink /vendor/bt_firmware /bt_firmware
    symlink /vendor/dsp /dsp

on init
    wait /dev/block/platform/soc/${ro.boot.bootdevice}
    symlink /dev/block/platform/soc/${ro.boot.bootdevice} /dev/block/bootdevice

on early-fs
    start vold

on fs
    mount_all --early
    # Firmware mounts precede vendor drivers which may request firmware at probe.
    exec u:r:vendor_modprobe:s0 -- /vendor/bin/modprobe -b -d /system/lib/modules --all=/system/lib/modules/modules.load
    exec u:r:vendor_modprobe:s0 -- /vendor/bin/modprobe -b -d /vendor/lib/modules -d /system/lib/modules --all=/vendor/lib/modules/modules.load
    chown root system /mnt/vendor/persist
    chmod 0771 /mnt/vendor/persist
    restorecon_recursive /mnt/vendor/persist
    mkdir /mnt/vendor/persist/secnvm 0770 system system
    mkdir /mnt/vendor/persist/data 0700 system system

on late-fs
    mount_all --late

on post-fs-data
    mkdir /data/vendor/display 0770 system graphics
    # Supplicant state and control sockets (matches stock).
    mkdir /data/vendor/wifi 0770 wifi wifi
    mkdir /data/vendor/wifi/wpa 0770 wifi wifi
    mkdir /data/vendor/wifi/wpa/sockets 0770 wifi wifi
    mkdir /data/vendor/tzstorage 0770 system system
    mkdir /data/vendor/qtee 0770 system system
    mkdir /data/vendor/pwr 0700 root root
    mkdir /data/vendor/perfd 2770 root system
    # Remote-processor crash dumps served through tftp_server (matches stock).
    mkdir /data/vendor/tombstones 0771 system system
    mkdir /data/vendor/tombstones/rfs 0771 system system
    # Vibrator control for the vibrator HAL (matches stock).
    chown system system /sys/class/leds/aw_vibrator/trigger
    chown system system /sys/class/leds/aw_vibrator/activate
    chown system system /sys/class/leds/aw_vibrator/brightness
    chown system system /sys/class/leds/aw_vibrator/duration
    chown system system /sys/class/leds/aw_vibrator/state
    chown system system /sys/class/leds/aw_vibrator/loop
    chown system system /sys/class/leds/aw_vibrator/seq
    chown system system /sys/class/leds/aw_vibrator/index
    chown system system /sys/class/leds/aw_vibrator/enable
    chown system system /sys/class/leds/aw_vibrator/rtp
    chown system system /sys/class/leds/aw_vibrator/activate_mode
    chown system system /sys/class/leds/aw_vibrator/gain

on early-boot
    verity_update_state

# The source-built composer runs as system and writes this node for panel
# brightness. Match the stock FP6 boot-time ownership.
on boot
    chown system system /sys/class/backlight/panel0-backlight/brightness

# Remote processors (matches stock init.qti.kernel.rc and init.target.rc): the
# ADSP provides USB role detection, charging and audio; the CDSP compute.
# Their firmware is on /vendor/firmware_mnt, mounted by mount_all --early.
on early-boot
    start vendor.pd_mapper
    # Unlike stock, which writes these from a background script, init waits
    # here: the DSP loaders boot the remote processor synchronously, so a slow
    # or failing DSP start delays the rest of early-boot and class core.
    # Measure this on the device before relying on it.
    write /sys/kernel/boot_adsp/boot 1
    write /sys/kernel/boot_cdsp/boot 1

# Wi-Fi (matches stock init.target.rc and init.vendor.wlan.rc). Fairphone's
# icnss2 holds the firmware handshake until the CE/FCC board data is chosen;
# DiamaneOS targets the EU FP6, which uses the CE board data (is_fcc 0). Then
# boot the WPSS processor that runs the QCA6750 firmware.
on early-boot
    write /sys/kernel/fps_reg/is_fcc 0
    write /sys/kernel/icnss/wlan_en_delay 1000
    write /sys/kernel/icnss/wpss_boot 1

# Stock grants CAP_NET_BIND_SERVICE through file capabilities; the prebuilts
# are installed without them, so init grants it to these services instead.
service vendor.pd_mapper /vendor/bin/pd-mapper
    class core
    user system
    group system
    capabilities NET_BIND_SERVICE

service vendor.per_mgr /vendor/bin/pm-service
    class core
    user system
    group system
    capabilities NET_BIND_SERVICE
    ioprio rt 4

service vendor.per_proxy /vendor/bin/pm-proxy
    class core
    user system
    group system
    disabled

on property:init.svc.vendor.per_mgr=running
    start vendor.per_proxy

on property:sys.shutdown.requested=*
    write /sys/kernel/qcom_rproc/shutdown_in_progress 1
    write /sys/kernel/shutdown_wlan/shutdown 1
    stop vendor.per_proxy
