# Selected FP6 graphics, trusted-execution and USB device ownership.
# Platform ueventd supplies standard input, framebuffer, DRM and DMA-heap rules.
# SELinux remains the authority for access by individual service domains.

/dev/kgsl                 0666   system     system
/dev/kgsl-3d0             0666   system     system
/dev/membuf               0664   system     system
/dev/dma_heap/qcom,*      0444   system     system
/dev/qseecom              0660   system     drmrpc
/dev/qce                  0660   system     drmrpc
/dev/smcinvoke            0660   system     drmrpc
# The stock FP6 RPMB rule lets the system-owned qseecomd listener serve
# hardware-backed Gatekeeper and KeyMint requests.
/dev/0:0:0:49476          0600   system     system
# The stock FP6 FocalTech node is owned by the system fingerprint service.
/dev/focaltech_fp          0660   system     system
# The stock NFC HAL runs as nfc and opens the Samsung controller node. Stock
# only sets this owner from nfc-service-sec.rc on boot (then 0770); ueventd
# sets it when the node is created, before any client can start the HAL.
/dev/sec-nfc              0660   nfc        nfc
/sys/class/typec/port0		data_role	0660	system	usb
/sys/class/typec/port0		power_role	0660	system	usb
/sys/class/typec/port0		port_type	0660	system	usb
/sys/class/typec/port0-partner	accessory_mode	0440	system	usb

# Display power and HDCP control for the composer (matches stock).
/sys/devices/platform/soc/ae00000.qcom,mdss_mdp power/control 0664 system graphics
/sys/devices/virtual/hdcp/msm_hdcp  min_level_change 0664    system  graphics

# USB controller role and speed for the USB HAL (matches stock).
/sys/bus/platform/devices/a600000.ssusb	dynamic_disable	0220	root	usb
/sys/bus/platform/devices/a600000.ssusb    mode        0660  system  usb
/sys/devices/platform/soc/a600000.ssusb/a600000.dwc3/udc/a600000.dwc3/current_speed     0660   system     system

# Notification LED for the lights HAL (matches stock).
/sys/class/leds/red    delay_on     0640    system    system
/sys/class/leds/red    delay_off    0640    system    system
/sys/class/leds/red    breath       0640    system    system
/sys/class/leds/red    repeat       0640    system    system
/sys/class/leds/red    hw_pattern   0640    system    system
/sys/class/leds/red    trigger      0640    system    system
/sys/class/leds/green  delay_on     0640    system    system
/sys/class/leds/green  delay_off    0640    system    system
/sys/class/leds/green  breath       0640    system    system
/sys/class/leds/green  repeat       0640    system    system
/sys/class/leds/green  hw_pattern   0640    system    system
/sys/class/leds/green  trigger      0640    system    system
/sys/class/leds/blue   delay_on     0640    system    system
/sys/class/leds/blue   delay_off    0640    system    system
/sys/class/leds/blue   breath       0640    system    system
/sys/class/leds/blue   repeat       0640    system    system
/sys/class/leds/blue   hw_pattern   0640    system    system
/sys/class/leds/blue   trigger      0640    system    system
# The Wi-Fi HAL (wifi) switches the QCA6750 host driver on and off (stock).
/dev/wlan                 0660   wifi       wifi
# Secure FastRPC to the ADSP: the sensors multi-HAL and sscrpcd (system) read and
# write; the audio PD listener (media) opens it read-only, as stock allows.
/dev/adsprpc-smd-secure   0640   system     media
# Remote processors. The peripheral manager (pm-service, user system) boots the
# modem through its remoteproc character device. Owner-only: closing the node
# after pm-service set shutdown-on-release stops the processor, so no group
# access (stock uses 0640).
/dev/remoteproc*          0600   system     system
# Modem remote storage (EFS) shared memory, mapped by rmt_storage (matches
# stock ueventd.rc).
/dev/uio0                 0660   system     system
/dev/uio1                 0660   system     system
/dev/uio2                 0660   system     system

# AudioReach GPR/shared memory and PAL speaker protection. ALSA /dev/snd/*
# permissions are supplied by platform ueventd; legacy MSM codec nodes are unused.
/dev/aud_pasthru_adsp     0660   system     audio
/dev/msm_audio_ion        0660   system     audio
/dev/aw882xx_smartpa      0660   system     audio
/dev/msm_adsp_sleepmon    0660   system     audio

# Bluetooth HAL (bluetooth user): chip power and version through btpower (stock
# ueventd.rc) and the HCI UART (stock init.qcom.rc sets bluetooth:net_bt 0660 on
# boot). The FM/codec nodes (btfmcodec_dev, bt_cp_ctrl, btfmslim) stay root-only.
/dev/btpower              0660   bluetooth  system
/dev/ttyHS0               0660   bluetooth  net_bt
