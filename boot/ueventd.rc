# Selected FP6 graphics, trusted-execution and USB device ownership.
# Platform ueventd supplies standard input, framebuffer, DRM and DMA-heap rules.
# SELinux remains the authority for access by individual service domains.

# The kernel cannot read the modem partition's firmware itself: it is mounted
# system-owned (fstab.qcom, as stock) and the kernel domain may not override
# file permissions. As stock, init.qcom.rc turns on the sysfs fallback and
# ueventd loads the ADSP, CDSP, modem, Wi-Fi, GPU and other firmware from here.
firmware_directories /vendor/firmware_mnt/image/
# The factory Wi-Fi MAC: the QCA6750 driver asks for
# wlan/qca_cld/qca6750/wlan_mac.bin at probe. imeiprovd --wlan-mac
# (hardware/diamaneos/ims) writes it from the traceability partition into this
# RAM-backed tree at post-fs. Only ueventd may read it (sepolicy/fp6/wlan_mac.te).
# Searched last, so a file of that name anywhere above would win (the image
# check no-wlan-mac-link keeps /vendor/firmware free of one). The kernel's own
# firmware path does not reach /mnt/vendor, so only ueventd ever opens it.
firmware_directories /mnt/vendor/wlan_mac/

/dev/kgsl                 0666   system     system
/dev/kgsl-3d0             0666   system     system
/dev/membuf               0664   system     system
/dev/dma_heap/qcom,*      0444   system     system
/dev/qseecom              0660   system     drmrpc
/dev/qce                  0660   system     drmrpc
/dev/smcinvoke            0660   system     drmrpc
# The boot control HAL (vendor_bootctl, CAP_SYS_RAWIO only, stock runs it as
# root) reads and writes the slot attributes in the GPTs of the LUNs with A/B
# partitions (sdb: xbl_a, sdc: xbl_b, sde: the rest, stock rawprogram1, 2, 4),
# the Virtual A/B merge status in misc, and switches the boot LUN through the
# UFS BSG node. The other LUNs stay root-only.
/dev/block/sdb            0660   root       vendor_bootctl
/dev/block/sdc            0660   root       vendor_bootctl
/dev/block/sde            0660   root       vendor_bootctl
/dev/block/platform/soc/1d84000.ufshc/by-name/misc   0660   root   vendor_bootctl
/dev/ufs-bsg*             0660   root       vendor_bootctl
# The stock FP6 FocalTech node is owned by the system fingerprint service.
/dev/focaltech_fp          0660   system     system
/sys/class/typec/port0		data_role	0660	system	usb
/sys/class/typec/port0		power_role	0660	system	usb
/sys/class/typec/port0		port_type	0660	system	usb
/sys/class/typec/port0-partner	accessory_mode	0440	system	usb

# The SoC serial number: root only (the kernel makes it 0444). No shipped
# program reads it. Platform sysfs rules still let the Bluetooth, Wi-Fi,
# supplicant, radio and TEE services' domains read it, and those run as their
# own users (sepolicy/fp6/soc_serial.te).
/sys/devices/soc0         serial_number    0400   root   root
# The UFS storage's serial number and the SCSI unit serial and identification
# pages of its LUNs (the kernel makes them 0444). No shipped program reads
# them. Their generic sysfs label is readable by 22 domains, among them the
# fingerprint and USB HALs, the composer and the TEE listener, which run as
# their own users. Root platform daemons can still read them.
/sys/devices/platform/soc/1d84000.ufshc   string_descriptors/serial_number   0400   root   root
/sys/devices/platform/soc/1d84000.ufshc/host0/target0:0:0/0:0:0:*   vpd_pg80   0400   root   root
/sys/devices/platform/soc/1d84000.ufshc/host0/target0:0:0/0:0:0:*   vpd_pg83   0400   root   root

# Display power and HDCP control for the composer (matches stock).
/sys/devices/platform/soc/ae00000.qcom,mdss_mdp power/control 0664 system graphics
/sys/devices/virtual/hdcp/msm_hdcp  min_level_change 0664    system  graphics

# Wake gestures of the touch controller, switched by the sensors HAL (system)
# for Display > Tap to wake (double tap) and Tap to check phone (single tap).
# Stock writes it as root from vendor init.
/sys/bus/spi/devices/spi0.0   gesture_wakeup   0660   system   system
# Taps the controller reported, read only by the sensors HAL.
/sys/bus/spi/devices/spi0.0   wake_gesture     0400   system   system

# USB controller role and speed for the USB HAL (matches stock).
/sys/bus/platform/devices/a600000.ssusb	dynamic_disable	0220	root	usb
/sys/bus/platform/devices/a600000.ssusb    mode        0660  system  usb
/sys/devices/platform/soc/a600000.ssusb/a600000.dwc3/udc/a600000.dwc3/current_speed     0660   system     system

# Notification LED for the lights HAL (matches stock).
/sys/class/leds/red    delay_on     0640    system    system
/sys/class/leds/red    delay_off    0640    system    system
/sys/class/leds/red    breath       0640    system    system
/sys/class/leds/red    repeat       0640    system    system
/sys/class/leds/red    hw_pattern   0640    system    system
/sys/class/leds/red    trigger      0640    system    system
/sys/class/leds/green  delay_on     0640    system    system
/sys/class/leds/green  delay_off    0640    system    system
/sys/class/leds/green  breath       0640    system    system
/sys/class/leds/green  repeat       0640    system    system
/sys/class/leds/green  hw_pattern   0640    system    system
/sys/class/leds/green  trigger      0640    system    system
/sys/class/leds/blue   delay_on     0640    system    system
/sys/class/leds/blue   delay_off    0640    system    system
/sys/class/leds/blue   breath       0640    system    system
/sys/class/leds/blue   repeat       0640    system    system
/sys/class/leds/blue   hw_pattern   0640    system    system
/sys/class/leds/blue   trigger      0640    system    system
# The Wi-Fi HAL (wifi) switches the QCA6750 host driver on and off (stock).
/dev/wlan                 0660   wifi       wifi
# Secure FastRPC to the ADSP for the sensors multi-HAL and sscrpcd (system).
/dev/adsprpc-smd-secure   0660   system     system
# Remote processors. The peripheral manager (pm-service, user system) boots the
# modem through its remoteproc character device. Owner-only: closing the node
# after pm-service set shutdown-on-release stops the processor, so no group
# access (stock uses 0640).
/dev/remoteproc*          0600   system     system
# Modem remote storage (EFS) shared memory, mapped by rmt_storage (matches
# stock ueventd.rc).
/dev/uio0                 0660   system     system
/dev/uio1                 0660   system     system
/dev/uio2                 0660   system     system
