// FP6 call-audio bridge. The stock radio daemon (qcrilNrd) serves
// IQcRilAudio/slot1 and /slot2 and sends each call's audio parameters (vsid,
// call_state, call_type, crs_call) to a registered client, which applies them
// with AudioFlinger's global setParameters; the audio HAL starts and stops the
// voice session from them. Every call's audio depends on this, emergency calls
// included. This app replaces the stock QtiTelephonyService with the same
// behaviour, MODIFY_AUDIO_SETTINGS and the narrowly allowlisted platform permission
// DIAMANEOS_CONTROL_CALL_AUDIO, instead of MODIFY_AUDIO_ROUTING or phone-state access.
//
// Signing: no certificate property, so the build signs it with the default
// application key, never the platform key. Privileged placement supports its
// signer-bound domain and its one dedicated call-key permission
// (sepolicy/telephony-system-ext/mac_permissions.xml and seapp_contexts). Its only privileged permission is the dedicated call-key authority, with an
// explicit system_ext allowlist; it receives no broad routing or phone access.
//
// API level: platform APIs, for the hidden ServiceManager.waitForService (the
// audioserver death watch) and AudioSystem.setParameters, which returns
// AudioFlinger's status. Soong then marks the app usesNonSdkApi, which lifts
// runtime hidden-API enforcement for system apps.
//
// The AIDL is a client-side copy of the radio daemon's frozen version 1. The
// flags make the generated stubs match it: VINTF stability (our request
// callback crosses into the vendor daemon) and the vendor's version and hash,
// which the daemon can query on that callback. There is no aidl_interface
// module on purpose: the interface is the vendor's, we only mirror it.

filegroup { name: "FP6CallAudioJavaSources", srcs: ["src/**/*.java"] }
filegroup { name: "FP6CallAudioAidlSources", srcs: ["aidl/**/*.aidl"] }

android_app {
    name: "FP6CallAudio",
    srcs: [
        ":FP6CallAudioJavaSources",
        ":FP6CallAudioAidlSources",
    ],
    aidl: {
        local_include_dirs: ["aidl"],
        flags: [
            "--stability=vintf",
            "--structured",
            "--version=1",
            "--hash=7807b67b5d557d9479da5c0f34c525bf48aaec90",
        ],
    },
    resource_dirs: ["res"],
    platform_apis: true,
    system_ext_specific: true,
    privileged: true,
    required: ["sysconfig-de.diamaneos.callaudio.xml", "privapp-permissions-de.diamaneos.callaudio.xml"],
}

prebuilt_etc {
    name: "sysconfig-de.diamaneos.callaudio.xml",
    src: "sysconfig-de.diamaneos.callaudio.xml",
    sub_dir: "sysconfig",
    system_ext_specific: true,
}

prebuilt_etc {
    name: "privapp-permissions-de.diamaneos.callaudio.xml",
    src: "privapp-permissions-de.diamaneos.callaudio.xml",
    sub_dir: "permissions",
    system_ext_specific: true,
}

// Status reporting (every audioserver change once and in order, the current
// status again after each registration, never a stale one) and the retries in
// the audioserver recovery window, plus bounded per-registration parameter work.
java_test_host {
    name: "FP6CallAudioHostTests",
    srcs: [
        "src/de/diamaneos/callaudio/Recovery.java",
        "src/de/diamaneos/callaudio/StatusRelay.java",
        "src/de/diamaneos/callaudio/ParameterBudget.java",
        "src/de/diamaneos/callaudio/AudioParameters.java",
        "tests/src/**/*.java",
    ],
    static_libs: ["junit"],
    test_options: {
        unit_test: true,
    },
}
