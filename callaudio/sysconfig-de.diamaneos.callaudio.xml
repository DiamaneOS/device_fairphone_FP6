<!--
     SPDX-License-Identifier: Apache-2.0
     Copyright 2026 The DiamaneOS Project

     The call-audio bridge carries the audio of every call, emergency calls
     included, so the user cannot disable it by mistake. SystemConfig
     "prevent-disable" adds the package to PackageManagerService's required
     system packages, which setApplicationEnabledSetting refuses to disable
     while the package is a system app.
-->
<config>
    <prevent-disable package="de.diamaneos.callaudio" />
</config>
