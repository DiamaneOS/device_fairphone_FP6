package {
    default_applicable_licenses: ["fp6_device_license"],
}

android_test {
    name: "FP6CallAudioAuthorizationTests",
    srcs: ["src/**/*.java"],
    manifest: "AndroidManifest.xml",
    // Keep only this self-target fixture's permissions and metadata.
    dont_merge_manifests: true,
    platform_apis: true,
    static_libs: ["androidx.test.runner", "androidx.test.ext.junit"],
    jni_libs: ["libfp6_callaudio_guard_test"],
    test_suites: ["device-tests"],
}

cc_library_shared {
    name: "libfp6_callaudio_guard_test",
    srcs: ["native/AudioStatus.cpp"],
    header_libs: ["jni_headers", "libnativehelper_header_only"],
    shared_libs: ["libbinder_ndk"],
    cflags: ["-Wall", "-Wextra", "-Werror"],
}
