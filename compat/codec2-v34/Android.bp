// Android 14 ABI for the stock Qualcomm Codec2 framework libraries (FP6 stock
// vendor libcodec2_vndk.so and libcodec2_hidl@1.0/1.1/1.2.so, built against
// Android 14). The tools renderer renames one dependency of each consumer to
// one of these libraries (NEEDED_REWRITES, same string length, input and
// output hashes pinned):
//   libcodec2_vndk.so:         libui.so -> uiv34.so, and its six
//                              android::GraphicBuffer imports to
//                              android::GraphicBufV34
//   libcodec2_hidl@1.0-1.2.so: libstagefright_bufferqueue_helper.so ->
//                              libstagefright_bqhelper_v34compat.so
// Each library links the library it stands in for, so every other symbol
// still comes from the real Android 17 library. Device-authored; no upstream
// code copied. Both are needed although the service exposes only encoders:
// the Android linker binds every symbol when a library loads, and the service
// links libcodec2_hidl@1.2 (which links @1.1 and @1.0) and libcodec2_vndk.

// - GraphicBufferV34.cpp: an Android 14 sized GraphicBuffer (256 bytes;
//   Android 17's is 3376) that fails closed, so the stock library's own
//   256-byte allocations never meet the Android 17 constructor;
// - GraphicBufferMapperV34.cpp: GraphicBufferMapper::lock with six arguments
//   and unlock(handle), which Android 17 dropped, forwarded to the Android 17
//   members.
// Every other libui symbol the stock library imports (mapper, allocator,
// Fence, Region) has the same layout in Android 17 and still comes from the
// real libui. The version script exports exactly the eight entry points.
cc_library_shared {
    name: "uiv34",
    vendor: true,
    compile_multilib: "64",
    srcs: [
        "GraphicBufferMapperV34.cpp",
        "GraphicBufferV34.cpp",
    ],
    version_script: "libuiv34.map.txt",
    cflags: [
        "-Wall",
        "-Werror",
        "-Wextra",
    ],
    shared_libs: [
        "libbase",
        "liblog",
        "libsync",
        "libui",
        "libutils",
    ],
}

// GraphicBufferSource::getHGraphicBufferProducer() const, which Android 17
// dropped (see GraphicBufferSourceV34.cpp).
cc_library_shared {
    name: "libstagefright_bqhelper_v34compat",
    vendor: true,
    compile_multilib: "64",
    srcs: ["GraphicBufferSourceV34.cpp"],
    cflags: [
        "-Wall",
        "-Werror",
        "-Wextra",
    ],
    shared_libs: [
        "android.hardware.graphics.bufferqueue@2.0",
        "libhidlbase",
        "liblog",
        "libstagefright_bufferqueue_helper",
        "libutils",
    ],
}
