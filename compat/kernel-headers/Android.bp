// Sanitized UAPI headers from the pinned FP6 kernel trees (see provenance.json),
// generated with the kernel's own scripts/headers_install.sh. The source-built
// Qualcomm display stack expects them under these module names, which LineageOS
// and CalyxOS generate during their kernel build.

package {
    default_applicable_licenses: ["fp6_kernel_uapi_headers_license"],
}

license {
    name: "fp6_kernel_uapi_headers_license",
    license_kinds: [
        "SPDX-license-identifier-GPL-2.0-only",
        "SPDX-license-identifier-Linux-syscall-note",
    ],
}

cc_defaults {
    name: "fp6_kernel_uapi_headers_defaults",
    export_include_dirs: ["include"],
    vendor_available: true,
    product_available: true,
    recovery_available: true,
}

cc_library_headers {
    name: "qti_kernel_headers",
    defaults: ["fp6_kernel_uapi_headers_defaults"],
}

cc_library_headers {
    name: "qti_display_kernel_headers",
    defaults: ["fp6_kernel_uapi_headers_defaults"],
}

cc_library_headers {
    name: "smmu_proxy_uapi_header",
    defaults: ["fp6_kernel_uapi_headers_defaults"],
}
