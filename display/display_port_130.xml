    <point><value>0.0193013</value><nits>3.146</nits></point>
    <point><value>0.0241877</value><nits>3.601</nits></point>
    <point><value>0.0290741</value><nits>4.099</nits></point>
    <point><value>0.0354264</value><nits>4.808</nits></point>
    <point><value>0.0415344</value><nits>5.549</nits></point>
    <point><value>0.0461764</value><nits>6.329</nits></point>
    <point><value>0.0522844</value><nits>7.317</nits></point>
    <point><value>0.0598583</value><nits>8.919</nits></point>
    <point><value>0.0686538</value><nits>11.25</nits></point>
    <point><value>0.078671</value><nits>14.40</nits></point>
    <point><value>0.0903983</value><nits>18.81</nits></point>
    <point><value>0.1031029</value><nits>24.66</nits></point>
    <point><value>0.1187394</value><nits>33.34</nits></point>
    <point><value>0.1319326</value><nits>41.59</nits></point>
    <point><value>0.1463475</value><nits>51.64</nits></point>
    <point><value>0.1668703</value><nits>67.96</nits></point>
    <point><value>0.184217</value><nits>83.43</nits></point>
    <point><value>0.2032739</value><nits>102.5</nits></point>
    <point><value>0.2228195</value><nits>124.9</nits></point>
    <point><value>0.2440753</value><nits>152.2</nits></point>
