<!-- Remaining selected HAL declarations are installed with their providers. -->
<manifest version="7.0" type="device" target-level="8">
    <!-- Stock certificate helper for the modem AUTH requests used by IWLAN. -->
    <hal format="hidl">
        <name>vendor.qti.hardware.cacert</name>
        <transport>hwbinder</transport>
        <fqname>@1.0::IService/default</fqname>
    </hal>
    <hal format="aidl">
        <name>android.hardware.gatekeeper</name>
        <version>1</version>
        <fqname>IGatekeeper/default</fqname>
    </hal>
    <!-- The AOSP audio service hosts the stock primary HAL, which registers the
         PAL and AGM HIDL services in the same process. -->
    <hal format="hidl">
        <name>android.hardware.audio</name>
        <transport>hwbinder</transport>
        <fqname>@7.1::IDevicesFactory/default</fqname>
    </hal>
    <hal format="hidl">
        <name>android.hardware.audio.effect</name>
        <transport>hwbinder</transport>
        <fqname>@7.0::IEffectsFactory/default</fqname>
    </hal>
    <hal format="hidl">
        <name>vendor.qti.hardware.pal</name>
        <transport>hwbinder</transport>
        <fqname>@1.0::IPAL/default</fqname>
    </hal>
    <hal format="hidl">
        <name>vendor.qti.hardware.AGMIPC</name>
        <transport>hwbinder</transport>
        <fqname>@1.0::IAGM/default</fqname>
    </hal>
    <!-- The Bluetooth HCI service (bluetooth/service.cpp) registers the stock
         Qualcomm implementation as IBluetoothHci 1.1 (and 1.0 through it). -->
    <hal format="hidl">
        <name>android.hardware.bluetooth</name>
        <transport>hwbinder</transport>
        <fqname>@1.1::IBluetoothHci/default</fqname>
    </hal>
    <!-- The stock Qualcomm Codec2 service registers the hardware video store,
         which lists only the Iris encoders (media/media.mk). Only the default
         instance: the platform's software store is declared by the framework
         manifest (manifest_media_c2_software.xml), and the stock fragment's
         extra "software" line is not carried over. -->
    <hal format="hidl">
        <name>android.hardware.media.c2</name>
        <transport>hwbinder</transport>
        <fqname>@1.2::IComponentStore/default</fqname>
    </hal>
</manifest>
