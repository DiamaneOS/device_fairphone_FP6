<!-- Remaining selected HAL declarations are installed with their providers. -->
<manifest version="7.0" type="device" target-level="8">
    <!-- The radio daemon offers the SIM's secure element to OMAPI, SIM1 as on
         stock. -->
    <hal format="aidl">
        <name>android.hardware.secure_element</name>
        <version>1</version>
        <fqname>ISecureElement/SIM1</fqname>
    </hal>
    <hal format="aidl">
        <name>android.hardware.gatekeeper</name>
        <version>1</version>
        <fqname>IGatekeeper/default</fqname>
    </hal>
    <!-- The AOSP audio service hosts the primary HAL, which registers the AGM
         HIDL service in the same process for libagmclient (PAL and the AGM
         ALSA plugins). It registers no PAL HIDL service. -->
    <hal format="hidl">
        <name>android.hardware.audio</name>
        <transport>hwbinder</transport>
        <fqname>@7.1::IDevicesFactory/default</fqname>
    </hal>
    <hal format="hidl">
        <name>android.hardware.audio.effect</name>
        <transport>hwbinder</transport>
        <fqname>@7.0::IEffectsFactory/default</fqname>
    </hal>
    <hal format="hidl">
        <name>vendor.qti.hardware.AGMIPC</name>
        <transport>hwbinder</transport>
        <fqname>@1.0::IAGM/default</fqname>
    </hal>
    <!-- The Bluetooth HCI service (bluetooth/service.cpp) registers the stock
         Qualcomm implementation as IBluetoothHci 1.1 (and 1.0 through it). -->
    <hal format="hidl">
        <name>android.hardware.bluetooth</name>
        <transport>hwbinder</transport>
        <fqname>@1.1::IBluetoothHci/default</fqname>
    </hal>
</manifest>
