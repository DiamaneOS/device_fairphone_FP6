# The stock Qualcomm Codec2 video service: hardware encoders, and hardware
# decoders when the owner turned them on (media/media.mk). Derived from the
# stock FP6 vendor/etc/init/vendor.qti.media.c2@1.0-service.rc
# (sha256 c29bfa76cf361423ea75bee88faee903283c3e0c85aeee5057cd436b1dd05f8a):
# - group mediacodec only. The encoders open only /dev/video33 and the
#   decoders only /dev/video32 (libqcodec2_v4l2codec: the encoder and decoder
#   constructors are the one user of each path; the media-controller lookup
#   returns early for both). boot/ueventd.rc and the actions below give that
#   group the encoder node, and the decoder node only while hardware decoding
#   is on. Stock's camera group would also open every camera V4L2, subdevice
#   and media node, UBWC-P, the non-secure FastRPC node and the ToF sensor.
#   Stock's mediadrm and drmrpc groups serve secure (DRM) playback through
#   QSEECom, which this product does not install; stock's system group has no
#   consumer in the selected closure.
# - task_profiles ProcessCapacityHigh replaces stock's
#   "writepid /dev/cpuset/foreground/tasks" (the AOSP Codec2 service rc does
#   the same).
# SYS_NICE and the real-time I/O priority are kept: the codec threads raise
# their scheduling priority (both seccomp policies allow setpriority and
# sched_setscheduler).
# Seccomp: libc2hwjail_avservices (media/seccomp), which the service loads in
# place of libavservices_minijail, installs DiamaneOS's filter
# (/vendor/etc/seccomp_policy/codec2-service.policy) before the service's
# main(), and the service's own SetUpMinijail call stacks the stock policies
# (codec2.vendor.{base,ext}-arm64.policy) on top. The phone checks confirm
# Seccomp: 2 and both filters in its status.
# /data/vendor/media (stock init.qcom.rc, 0770 mediacodec media) is not
# created: the Qualcomm codecs only write dumps there, and dumps are off in
# the stock target specification (max_*_for_dump 0).
service vendor-qti-media-c2-hal-1-0 /vendor/bin/hw/vendor.qti.media.c2@1.0-service
    class hal
    user mediacodec
    group mediacodec
    capabilities SYS_NICE
    ioprio rt 4
    task_profiles ProcessCapacityHigh

# Hardware video decoding (Settings > Security & privacy > Exploit protection;
# off by default). Settings stores the owner's choice in
# persist.diamaneos.hw_video_decode ("1" on, "0" off; only Settings may set
# it, sepolicy/system-ext-private). It is applied once per boot, here: the
# persistent properties are loaded at post-fs-data, and zygote-start comes
# before the codec service (class hal, at boot), the media framework
# (mediaserver, class main) and every app, so every component sees one state
# for the whole boot. A change takes effect at the next boot.
#
# Init runs the actions of one trigger in file order, and a read-only property
# keeps the first value it is given: with the switch on, the first action
# sets the decoding state, and the second action's setprop lines change
# nothing. Any other value, or none, leaves hardware decoding off.
# libc2hwjail_avservices checks the result in the codec service before it
# starts (the mode, the target variant, the target specification and the
# decoder node), and stops the service if anything differs.
on zygote-start && property:persist.diamaneos.hw_video_decode=1
    setprop ro.vendor.diamaneos.hw_video_decode 1
    # The framework's codec list and the Qualcomm target specification with
    # the three decoders (both pinned derivations, media/media.mk).
    setprop ro.media.xml_variant.codecs _volcano_v1_hwdec
    setprop vendor.media.target_variant _volcano_v1_hwdec
    # The decoder node for the codec service's group. ueventd made it
    # root-only; msm_video.ko is a boot module, so the node normally exists.
    wait /dev/video32
    chown root mediacodec /dev/video32
    chmod 0660 /dev/video32

on zygote-start
    setprop ro.vendor.diamaneos.hw_video_decode 0
    setprop ro.media.xml_variant.codecs _volcano_v1
