// FP6 hardware configuration as static vendor runtime resource overlays, so the
// generic system image stays device independent.

runtime_resource_overlay {
    name: "FP6FrameworksOverlay",
    vendor: true,
    manifest: "FP6FrameworksOverlay/AndroidManifest.xml",
    resource_dirs: ["FP6FrameworksOverlay/res"],
}

runtime_resource_overlay {
    name: "FP6SettingsOverlay",
    vendor: true,
    manifest: "FP6SettingsOverlay/AndroidManifest.xml",
    resource_dirs: ["FP6SettingsOverlay/res"],
}

runtime_resource_overlay {
    name: "FP6SystemUIOverlay",
    vendor: true,
    manifest: "FP6SystemUIOverlay/AndroidManifest.xml",
    resource_dirs: ["FP6SystemUIOverlay/res"],
}

runtime_resource_overlay {
    name: "FP6TeleServiceOverlay",
    vendor: true,
    manifest: "FP6TeleServiceOverlay/AndroidManifest.xml",
    resource_dirs: ["FP6TeleServiceOverlay/res"],
}

runtime_resource_overlay {
    name: "FP6CarrierConfigOverlay",
    vendor: true,
    manifest: "FP6CarrierConfigOverlay/AndroidManifest.xml",
    resource_dirs: ["FP6CarrierConfigOverlay/res"],
}
