    <!-- Panel luminance (nits) at each brightness level. Stock lists the
         panel's 12-bit levels 1, 250, 365 ... 2048, 4095; Android reads this
         array on its 0-255 scale, and the composer maps brightness linearly
         onto panel levels 1-4094, so each level L becomes
         round(1 + (L - 1) / 4093 * 254). -->
    <integer-array name="config_screenBrightnessBacklight">
        <item>1</item>
        <item>16</item>
        <item>24</item>
        <item>29</item>
