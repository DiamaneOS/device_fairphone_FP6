<resources>
    <!-- Automatic brightness, from the FP6.QREL.16.100.0 factory
         FrameworksResCommon_Sys overlay. The ambient light sensor comes from
         the sensors multi-HAL. -->
    <bool name="config_automatic_brightness_available">true</bool>

    <!-- Ambient light (lux) thresholds and the display brightness (nits)
         wanted between them; one more nits value than lux levels. The last
         value is the top of the range: from 20000 lux the panel runs at
         level 3480. Values above 757 nits need the high-brightness mode of
         display/display_port_130.xml (10000 lux or more). -->
    <integer-array name="config_autoBrightnessLevels">
        <item>2</item>
        <item>4</item>
        <item>10</item>
        <item>20</item>
        <item>40</item>
        <item>100</item>
        <item>200</item>
        <item>500</item>
        <item>1000</item>
        <item>2000</item>
        <item>3000</item>
        <item>4000</item>
        <item>5000</item>
        <item>6000</item>
        <item>8000</item>
        <item>10000</item>
        <item>20000</item>
    </integer-array>
    <array name="config_autoBrightnessDisplayValuesNits">
        <item>3</item>
        <item>7</item>
        <item>10</item>
        <item>24</item>
        <item>64</item>
        <item>82</item>
        <item>90</item>
        <item>100</item>
        <item>120</item>
        <item>170</item>
        <item>280</item>
        <item>350</item>
        <item>400</item>
        <item>450</item>
        <item>500</item>
        <item>580</item>
        <item>650</item>
        <item>1151</item>
    </array>

    <!-- Brightness range of display/display_port_130.xml, as backlight
         (panel level = 1 + backlight * 4093): level 10 (2.0 nits) to level
         3480 (1151 nits). Both must be set, or neither is used. The minimum
         must equal the first backlight point of that file. -->
    <item name="config_screenBrightnessSettingMinimumFloat" format="float" type="dimen">0.002199</item>
    <item name="config_screenBrightnessSettingMaximumFloat" format="float" type="dimen">0.85</item>

    <!-- Loads the evenDimmer brightness map of that file, which makes
         brightness linear in nits. It has no points below the panel floor, so
         nothing is dimmed in software. Android offers no Extra dim switch
         while this is on. -->
    <bool name="config_evenDimmerEnabled">true</bool>

    <!-- Brightness values (0 = 2.0 nits, 1 = 1151 nits, linear in nits):
         default 100 nits; dimmed before the screen times out 16 nits, and at
         least 5.7 nits below the current brightness. -->
    <item name="config_screenBrightnessSettingDefaultFloat" format="float" type="dimen">0.0853</item>
    <item name="config_screenBrightnessDimFloat" format="float" type="dimen">0.0122</item>
    <item name="config_screenBrightnessMinimumDimAmountFloat" format="float" type="dimen">0.005</item>

    <integer name="config_autoBrightnessBrighteningLightDebounce">1000</integer>
    <integer name="config_autoBrightnessDarkeningLightDebounce">1000</integer>
</resources>
