<resources>
    <!-- FP6.QREL.16.100.0 factory FrameworksResCommon_Sys overlay. -->
    <dimen name="status_bar_height_portrait">48dp</dimen>
    <!-- The front camera hole, measured on the panel (a calibration grid photographed
         around the hole, 2026-09-28): a circle of radius 36.8 px centred on the display's
         horizontal centre, 64 px below the top edge. The path is that circle, rounded out
         to 37 px, so everything that follows the cutout's shape (the Tally lens ring among
         it) hugs the real hole. The factory value was a 60 x 110 px rectangle, which is
         narrower than the hole (74 px): the rectangle approximation below keeps the factory
         rectangle's height, so the status bar and app insets stay 110 px, and takes the
         hole's width, so no status bar content sits under its edges. -->
    <string name="config_mainBuiltInDisplayCutout" translatable="false">M 0,27 A 37,37 0 1 1 0,101 A 37,37 0 1 1 0,27 Z</string>
    <string name="config_mainBuiltInDisplayCutoutRectApproximation" translatable="false">M -37,0 L -37,110 L 37,110 L 37,0 Z</string>

    <!-- The FP6 has no hardware navigation keys. Without this the window
         manager reports no navigation bar, so SystemUI creates neither the bar
         nor the back gesture handler: edge back swipes do nothing and 3-button
         mode shows no buttons. Stock also sets config_navBarInteractionMode 2,
         which is already the default. -->
    <bool name="config_showNavigationBar">true</bool>

    <!-- Stock leaves the default refresh rate unset (0) and the peak uncapped
         (240), so the 120 Hz panel mode is used. Android's default of 60 caps
         every mode. We use 120, the panel's highest mode, rather than 240:
         Settings shows Smooth display as on only when this equals the
         highest mode. -->
    <integer name="config_defaultRefreshRate">0</integer>
    <integer name="config_defaultPeakRefreshRate">120</integer>

    <!-- Pin the panel to 60 Hz while the camera app is in front:
         - photo mode's 4:3 preview (1600x1200) is over the display's
           1088-line rotation limit, so the GPU composes it (~10 ms a frame);
         - at 90/120 Hz that misses every deadline, at 60 Hz it fits;
         - frameworks_base 89ac1c80 caps only the render rate; this list is
           the knob that caps the physical mode, for listed apps only. -->
    <string-array name="config_highRefreshRateBlacklist" translatable="false">
        <item>app.grapheneos.camera</item>
    </string-array>

    <!-- FP6.QREL.16.100.0 factory FrameworksResTarget_Vendor overlay. -->
    <dimen name="rounded_corner_radius">20dp</dimen>
    <string name="config_mainDisplayShape" translatable="false">M20 0h1040s20 0 20 20v2360s0 20 -20 20h-1040s-20 0 -20 -20v-2360s0 -20 20 -20</string>

    <!-- Stock uses 0dp, which puts the status bar clock and battery inside the
         physical screen corners; keep them clear of the corners. -->
    <dimen name="rounded_corner_content_padding">24dp</dimen>

    <!-- FP6.QREL.16.100.0 factory FrameworksResCommon_Sys overlay: the
         controller supports LE peripheral (advertising) mode. -->
    <bool name="config_bluetooth_le_peripheral_mode_supported">true</bool>

    <!-- Colour modes the panel calibration (qdcm_calib_data_nt37705...json)
         supports: Natural, and the vendor modes 256 (boosted) and 257
         (adaptive), as stock's android.overlay.common. All three compose in
         sRGB (7): the calibration has no SDR Display-P3 mode, and stock's
         "system default" for Natural lets SurfaceFlinger pick Display-P3
         whenever a P3 layer such as the status bar is visible. -->
    <integer-array name="config_availableColorModes">
        <item>0</item>
        <item>256</item>
        <item>257</item>
    </integer-array>
    <integer-array name="config_displayCompositionColorModes">
        <item>0</item>
        <item>256</item>
        <item>257</item>
    </integer-array>
    <integer-array name="config_displayCompositionColorSpaces">
        <item>7</item>
        <item>7</item>
        <item>7</item>
    </integer-array>

    <!-- FP6.QREL.16.100.0 factory framework-res: the touch controller can wake
         the phone on a double tap while the screen is off or shows the
         always-on display. Settings then offers Display > Tap to wake (off
         until turned on). With the double-tap sensor in doze.xml, the
         DiamaneOS Settings switch drives Android's doze double tap
         (doze_pulse_on_double_tap) instead of the power HAL mode, so SystemUI
         checks the proximity sensor first; the power HAL ignores
         Mode::DOUBLE_TAP_TO_WAKE. -->
    <bool name="config_supportDoubleTapWake">true</bool>

    <!-- The source-built display HAL applies colour transforms in hardware
         (DisplayCapability::SKIP_CLIENT_COLOR_TRANSFORM, SDM colour manager), so
         Night Light, Extra dim and the Modes grayscale effect are offered and
         run on the display pipeline instead of the GPU. AOSP ties the first two
         to this value; they are set explicitly so an overlay change cannot
         silently drop them. -->
    <bool name="config_setColorTransformAccelerated">true</bool>
    <bool name="config_nightDisplayAvailable">true</bool>
    <bool name="config_reduceBrightColorsAvailable">true</bool>

    <!-- Keyboard key presses compose the CLICK primitive at this amplitude,
         which the FP6 vibrator HAL plays as the medium tick
         (Awinic RAM wave 3 at gain 0x40); other clicks keep their own effect. -->
    <item name="config_keyboardHapticFeedbackFixedAmplitude" format="float" type="dimen">0.5</item>

    <!-- Camera and microphone access toggles, as on GrapheneOS's Pixels:
         software sensor privacy. The framework blocks the camera and
         microphone app ops and the camera service blocks or mutes cameras,
         whatever the HALs do. config_supportsHardware*Toggle stay false: the
         only hardware state is the Moments switch's kernel floor, which the
         input service reports as a hardware microphone toggle while it
         blocks (config_momentsKernelFloorPath). -->
    <bool name="config_supportsCamToggle">true</bool>
    <bool name="config_supportsMicToggle">true</bool>

    <!-- The Moments switch: the slider on the side (privacy switch driver,
         EV_SW SW_PEN_INSERTED, as gpio-keys reported it). The kernel reports 1
         with the slider up and 0 with it down; down means Moments on, so on
         is value 0. -->
    <integer name="config_momentsSwitchCode">15</integer>
    <integer name="config_momentsSwitchActiveValue">0</integer>

    <!-- The kernel floor: the privacy switch driver's (diamaneos_privsw) state:
         what it enforces this boot and what it blocks now. -->
    <string name="config_momentsKernelFloorPath" translatable="false">/sys/kernel/privacy_switch/state</string>
    <!-- GrapheneOS's USB-C port control (Settings > Security & privacy >
         Exploit protection > USB-C port). The device side is the USB
         controller's data switch and, for Off, the charger input switch in
         the ADSP charger firmware (boot/init.qcom.usb.rc): Off turns off data
         and charging, Charging-only turns off data. Without this a user
         build has no USB data at all, because GrapheneOS's first-stage init
         refuses new USB connections at every boot of a non-debuggable build
         and only this feature lifts it. No pogo pins, so
         config_usb_port_security_applies_to_pogo_pins stays false. -->
    <bool name="config_usbPortSecuritySupported">true</bool>
</resources>
