<resources xmlns:xliff="urn:oasis:names:tc:xliff:document:1.2">
    <!-- Settings > Battery > Charging optimization, GrapheneOS's charge limit
         screen. GrapheneOS leaves these empty in Settings and Pixel builds
         fill them from the stock Pixel apps. "Off" is Settings' translated
         switch_off_text. German, French, Spanish and Italian are our own.
         While the limit holds, Android's own translated "Charging on hold to
         protect battery" texts are shown. -->
    <string name="charging_optimization_title">Charging optimization</string>
    <string name="charging_optimization_entry_summary_charge_limit">Limit to <xliff:g id="percentage" example="80%">%1$s</xliff:g></string>
    <string name="charging_optimization_summary_off">Off</string>
    <string name="charging_optimization_footer_message_charging_limit">To help extend your battery’s lifespan, charging pauses at <xliff:g id="limit" example="80%">%1$s</xliff:g> and resumes just below it. Turn this off to charge to <xliff:g id="full" example="100%">%2$s</xliff:g>.</string>
    <string name="charge_limit_indexing_keywords">charge limit, battery protect, battery health</string>
</resources>
