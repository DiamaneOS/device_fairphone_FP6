<resources>
    <!-- Show Display > Smooth display, the user switch between 60 Hz and the
         panel's 120 Hz peak. -->
    <bool name="config_show_smooth_display">true</bool>

    <!-- Labels for the colour modes in the framework's config_availableColorModes
         (0, 256, 257). Settings pairs this list, by position, with its own
         translated config_color_mode_options_strings: Natural, Boosted,
         Saturated, Adaptive. Put the panel's vendor modes where their names
         are, as stock FP6 Settings does: 256 is the calibration's "boosted"
         mode and 257 its "adaptive" mode. Saturated (2) is not offered, so it
         is never shown. Keep this list the same length and order as Settings'
         strings list: a length mismatch crashes Settings > Display. -->
    <integer-array name="config_color_mode_options_values" translatable="false">
        <item>0</item>
        <item>256</item>
        <item>2</item>
        <item>257</item>
    </integer-array>
</resources>
