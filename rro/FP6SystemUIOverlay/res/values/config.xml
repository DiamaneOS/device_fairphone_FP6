<resources>
    <!-- The display HAL supports the doze power state on the built-in panel,
         as in the factory SystemUIResCommon_Sys overlay. Without this,
         SystemUI keeps the panel in full power mode while it shows the
         always-on display, and does not listen to the proximity sensor.
         Doze-suspend stays unsupported, as in stock: the panel has no LP2
         command set. -->
    <bool name="doze_display_state_supported">true</bool>

    <!-- Tap to wake and Tap to check phone: the touch controller also reports
         taps through a pocket or bag, so a single or double tap wakes the
         screen only when the proximity sensor is not covered. Needs the
         DiamaneOS SystemUI change that adds this resource. Without it a tap
         wakes without the check. -->
    <bool name="doze_proximity_check_before_tap">true</bool>

    <!-- The proximity sensor reports 0 when covered and 131.6 when not, but its
         maximum range is 131.60072. Without a threshold SystemUI compares
         against the maximum range and reads every value as near, so the
         lock screen's falsing check treats each swipe as a pocket touch.
         5 cm is the threshold the display's proximity handling uses. SystemUI
         reads the threshold only with a sensor type, and this type selects the
         same wake-up sensor it uses without one. -->
    <string name="proximity_sensor_type" translatable="false">android.sensor.proximity</string>
    <item name="proximity_sensor_threshold" format="float" type="dimen">5.0</item>

    <!-- The FP6 volume buttons are on the left edge (the power button with the
         fingerprint sensor is on the right). Show the volume dialog next to
         them, as stock FP6 does. Needs the DiamaneOS SystemUI change that adds
         this resource. Without it the overlay has no effect. -->
    <bool name="config_volumeDialogOnLeft">true</bool>

    <!-- The front camera's lens for the Tally lens ring and the location lamp by the
         lens (SystemUI's tally_lens.xml): the hole measured on the panel, centred on the
         display's horizontal centre, 64 px below the top edge, radius 37 px (36.8 px
         measured, rounded out), in the same pixels as config_mainBuiltInDisplayCutout. -->
    <dimen name="tally_lens_center_x">0px</dimen>
    <dimen name="tally_lens_center_y">64px</dimen>
    <dimen name="tally_lens_radius">37px</dimen>
</resources>
