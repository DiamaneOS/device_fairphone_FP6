<!-- FP6 Wi-Fi capabilities, as Fairphone's Wi-Fi resource overlays declare them
     (factory 16.111.0). Without them the Wi-Fi service treats the hardware as
     unable to randomise its MAC address and to scan while the screen is off. -->
<resources>
    <!-- Connect with a randomised MAC address, not the hardware one. -->
    <bool name="config_wifi_connected_mac_randomization_supported">true</bool>
    <!-- Offloaded scans with the screen off, so saved networks reconnect. -->
    <bool name="config_wifi_background_scan_support">true</bool>
    <bool name="config_wifiEnablePartialInitialScan">true</bool>

    <bool name="config_wifi5ghzSupport">true</bool>
    <bool name="config_wifi6ghzSupport">true</bool>
    <bool name="config_wifiSaeH2eSupported">true</bool>
    <bool name="config_wifiSaeUpgradeOffloadEnabled">true</bool>
    <bool name="config_wifiDriverSupportedNl80211RegChangedEvent">true</bool>
    <bool name="config_wifiStaDynamicCountryCodeUpdateSupported">true</bool>
    <bool name="config_wifiUpdateCountryCodeFromScanResultGeneric">true</bool>
    <bool name="config_wifiApplicationCentricQosPolicyFeatureEnabled">true</bool>
    <bool name="config_wifiNetworkCentricQosPolicyFeatureEnabled">true</bool>
    <integer name="config_wifiBssidBlocklistMonitorApUnableToHandleNewStaThreshold">3</integer>
    <integer name="config_wifiDisableReasonByWrongPasswordThreshold">2</integer>
    <integer name="config_wifiMaxNumWifiConfigurations">1000</integer>
    <string name="config_wifi_tcp_buffers" translatable="false">524288,1048576,2097152,524288,1048576,4194304</string>
    <string-array name="config_wifiCharsetsForSsidTranslation" translatable="false">
        <item>zh,GBK</item>
    </string-array>

    <!-- Give IMS a second to move a call to cellular before Wi-Fi disconnects. -->
    <integer name="config_wifiDelayDisconnectOnImsLostMs">1000</integer>

    <!-- Lower Wi-Fi transmit power near the head and during calls (SAR). -->
    <bool name="config_wifi_framework_enable_sar_tx_power_limit">true</bool>

    <!-- Hotspot, as stock declares it: a new random MAC address at each start
         (Android's default once AP randomisation is declared), automatic
         channel selection, WPA3 (SAE), 802.11ac and ax, the 6 GHz band, HE
         single-user beamforming and up to 32 clients. Stock's 802.11be value is
         left out: the QCA6750 is an 802.11ax chip, and hostapd is built
         without be. Other values left out: wifi/README.md. -->
    <bool name="config_wifi_ap_mac_randomization_supported">true</bool>
    <bool name="config_wifi_softap_acs_supported">true</bool>
    <bool name="config_wifi_softap_sae_supported">true</bool>
    <bool name="config_wifi_softap_ieee80211ac_supported">true</bool>
    <bool name="config_wifiSoftapIeee80211axSupported">true</bool>
    <bool name="config_wifiSoftap6ghzSupported">true</bool>
    <bool name="config_wifiSoftapHeSuBeamformerSupported">true</bool>
    <bool name="config_wifiSoftapHeSuBeamformeeSupported">true</bool>
    <integer name="config_wifiHardwareSoftapMaxClientCount">32</integer>
    <!-- Lower the transmit power while the hotspot is on (SAR), as stock. -->
    <bool name="config_wifi_framework_enable_soft_ap_sar_tx_power_limit">true</bool>

    <!-- Wi-Fi Direct with random device and group addresses. -->
    <bool name="config_wifi_p2p_mac_randomization_supported">true</bool>
</resources>
