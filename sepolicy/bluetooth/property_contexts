# The only properties the Bluetooth service (the SoC name, bluetooth/service.cpp)
# and the stock HCI implementation set (HCI implementation property_set calls
# 0x52918, 0x52ac8, 0x5829c, 0x592ac, 0x5aaf0, 0x5cfcc, 0x5d09c, and
# Logger::PropertySet at 0x50404 and 0x50694). Exact entries take precedence
# over the imported vendor_bluetooth_prop prefixes (vendor-common/property_contexts
# lines 27-33).
persist.vendor.qcom.bluetooth.soc                         u:object_r:vendor_bluetooth_hal_state_prop:s0 exact string
persist.vendor.qcom.bluetooth.scram.enabled               u:object_r:vendor_bluetooth_hal_state_prop:s0 exact string
persist.vendor.service.bdroid.bdaddr                      u:object_r:vendor_bluetooth_hal_state_prop:s0 exact string
persist.vendor.service.bdroid.system_delay_crash_count    u:object_r:vendor_bluetooth_hal_state_prop:s0 exact string
persist.vendor.service.bdroid.rxthread.stuck.count        u:object_r:vendor_bluetooth_hal_state_prop:s0 exact string
# The factory Bluetooth address (property.te). The HCI implementation's
# BluetoothAddress::GetLocalAddress (0x4fd14) tries, in order: .bt_nv.bin,
# ro.vendor.bt.bdaddr_path, this property (0x50154), the modem NV (off), then
# the stored generated address (persist.vendor.service.bdroid.bdaddr), and
# generates one only when all fail.
ro.vendor.bt.boot.macaddr                                 u:object_r:vendor_bluetooth_address_prop:s0 exact string
