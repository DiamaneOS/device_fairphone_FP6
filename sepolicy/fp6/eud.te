# Qualcomm's embedded USB debugger (EUD) stays off. Its driver (eud.ko) must
# stay loaded: the USB controller takes its cable events from the EUD node in
# the SoC device tree. Writing 1 to /sys/module/eud/parameters/enable (0644
# root) turns the debugger on. The generic sysfs label let vold, the USB HAL
# and vfio_handler write it; its own type (genfs line in
# fp6/genfs_contexts) leaves only the platform's sysfs_type writers, ueventd
# and vendor_init, which act only on the reviewed ueventd and init files.
# Reads stay as the platform grants them: the value only tells whether EUD is on.
type vendor_sysfs_eud_enable, sysfs_type, fs_type;

# Nothing else may write it: a later rule that adds a writer fails the build.
neverallow {
  domain
  -ueventd
  -vendor_init
} vendor_sysfs_eud_enable:file { write append };
