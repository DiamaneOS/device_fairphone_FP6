/(vendor|system/vendor)/bin/sscrpcd     u:object_r:vendor_sensors_exec:s0
/data/vendor/sensors(/.*)?              u:object_r:vendor_sensors_vendor_data_file:s0
# Sensor types the sensors HAL waits for at start (hal_sensors_default.te).
/mnt/vendor/persist/sensors/sensors_list\.txt u:object_r:vendor_persist_sensors_list_file:s0
/data/vendor/display(/.*)?              u:object_r:vendor_display_vendor_data_file:s0
# Adreno shader compiler, loaded by the in-process GLES driver (stock label).
/vendor/lib(64)?/libllvm-qgl\.so        u:object_r:same_process_hal_file:s0
/dev/focaltech_fp                       u:object_r:ff_device:s0
# Touch controller wake-gesture switch and its tap report (sensors HAL). The
# rest of the touch device keeps the factory-test type fp_mmitest_sysfs.
/sys/devices/platform/soc/ac0000\.qcom,qupv3_0_geni_se/a80000\.spi/spi_master/spi0/spi0\.0/gesture_wakeup u:object_r:vendor_sysfs_touch_gesture:s0
/sys/devices/platform/soc/ac0000\.qcom,qupv3_0_geni_se/a80000\.spi/spi_master/spi0/spi0\.0/wake_gesture u:object_r:vendor_sysfs_touch_wake_gesture:s0
# Power HAL (power.te): LineageOS libperfmgr in the platform power HAL domain,
# and the GPU nodes it writes: devfreq floor and cap, and the wake trigger.
/vendor/bin/hw/android\.hardware\.power-service\.lineage-libperfmgr u:object_r:hal_power_default_exec:s0
/sys/devices/platform/soc/3d00000\.qcom,kgsl-3d0/devfreq/3d00000\.qcom,kgsl-3d0/min_freq u:object_r:vendor_sysfs_kgsl_limit:s0
/sys/devices/platform/soc/3d00000\.qcom,kgsl-3d0/devfreq/3d00000\.qcom,kgsl-3d0/max_freq u:object_r:vendor_sysfs_kgsl_limit:s0
/sys/devices/platform/soc/3d00000\.qcom,kgsl-3d0/kgsl/kgsl-3d0/touch_wake u:object_r:vendor_sysfs_kgsl_limit:s0
# Power stats HAL (power_stats.te) in the platform power stats HAL domain, and
# the qcom_stats sleep counter device it reads.
/vendor/bin/hw/android\.hardware\.power\.stats-service\.fp6 u:object_r:hal_power_stats_default_exec:s0
/dev/stats                              u:object_r:vendor_qcom_stats_device:s0
