# Wakeup sources of the fingerprint, hall and NFC devices, read by system_suspend.
genfscon sysfs /devices/platform/soc/soc:focalfp_ft9362/wakeup u:object_r:sysfs_wakeup:s0
genfscon sysfs /devices/platform/soc/soc:hall_1/wakeup u:object_r:sysfs_wakeup:s0
genfscon sysfs /devices/platform/soc/ac0000.qcom,qupv3_0_geni_se/a84000.i2c/i2c-1/1-0027/wakeup u:object_r:sysfs_wakeup:s0
# The SoC serial number, readable by no vendor service (soc_serial.te); the
# rest of /sys/devices/soc0 keeps its vendor-common labels.
genfscon sysfs /devices/soc0/serial_number u:object_r:vendor_sysfs_soc_serial:s0
# UFS LUN 0 (userdata) queue settings that platform init.rc tunes.
genfscon sysfs /devices/platform/soc/1d84000.ufshc/host0/target0:0:0/0:0:0:0/block u:object_r:sysfs_devices_block:s0
# The root disk's discard cap, the one node there platform init.rc writes
# (storage.te); the longer path wins over the block entry above.
genfscon sysfs /devices/platform/soc/1d84000.ufshc/host0/target0:0:0/0:0:0:0/block/sda/queue/discard_max_bytes u:object_r:vendor_sysfs_ufs_discard_max:s0
# WALT and VM tuning set by init.fp6.perf.rc and perf HAL boosts (perf.te).
genfscon proc /sys/walt u:object_r:vendor_proc_walt:s0
genfscon proc /sys/vm/swappiness u:object_r:vendor_proc_vm_tuning:s0
genfscon proc /sys/vm/min_free_kbytes u:object_r:vendor_proc_vm_tuning:s0
genfscon proc /sys/vm/compaction_proactiveness u:object_r:vendor_proc_compaction:s0
# TCP small-queue limit tuned by the Wi-Fi HAL (platform.te).
genfscon proc /sys/net/ipv4/tcp_limit_output_bytes u:object_r:vendor_proc_tcp_limit_output_bytes:s0
# Awinic haptics nodes the vibrator HAL writes (vibrator.te). genfs matches
# path prefixes, so "activate" also labels activate_mode; that node is not
# chowned to system, so the HAL still cannot write it.
genfscon sysfs /devices/platform/soc/8c0000.qcom,qupv3_1_geni_se/880000.i2c/i2c-7/7-005a/leds/aw_vibrator/activate u:object_r:vendor_sysfs_aw_vibrator:s0
genfscon sysfs /devices/platform/soc/8c0000.qcom,qupv3_1_geni_se/880000.i2c/i2c-7/7-005a/leds/aw_vibrator/brightness u:object_r:vendor_sysfs_aw_vibrator:s0
genfscon sysfs /devices/platform/soc/8c0000.qcom,qupv3_1_geni_se/880000.i2c/i2c-7/7-005a/leds/aw_vibrator/duration u:object_r:vendor_sysfs_aw_vibrator:s0
genfscon sysfs /devices/platform/soc/8c0000.qcom,qupv3_1_geni_se/880000.i2c/i2c-7/7-005a/leds/aw_vibrator/gain u:object_r:vendor_sysfs_aw_vibrator:s0
genfscon sysfs /devices/platform/soc/8c0000.qcom,qupv3_1_geni_se/880000.i2c/i2c-7/7-005a/leds/aw_vibrator/loop u:object_r:vendor_sysfs_aw_vibrator:s0
genfscon sysfs /devices/platform/soc/8c0000.qcom,qupv3_1_geni_se/880000.i2c/i2c-7/7-005a/leds/aw_vibrator/seq u:object_r:vendor_sysfs_aw_vibrator:s0
# Extcon cable names and states that system_server reads for DisplayPort
# (HDMI) and wired-headset detection (platform sysfs_extcon). They replace the
# imported per-index vendor_sysfs_graphics lines, which matched whichever
# extcon device got that number. The EUD debug port's extcon stays unlabelled.
genfscon sysfs /devices/platform/soc/soc:qcom,msm-ext-disp/extcon u:object_r:sysfs_extcon:s0
genfscon sysfs /devices/platform/soc/soc:spf_core_platform/soc:spf_core_platform:lpass-cdc/wcd9378-codec/extcon u:object_r:sysfs_extcon:s0
# CPU frequency floors and caps the power HAL writes (power.te). The rest of
# /sys/devices/system/cpu keeps the platform sysfs_devices_system_cpu.
genfscon sysfs /devices/system/cpu/cpufreq/policy0/scaling_min_freq u:object_r:vendor_sysfs_cpufreq_limit:s0
genfscon sysfs /devices/system/cpu/cpufreq/policy0/scaling_max_freq u:object_r:vendor_sysfs_cpufreq_limit:s0
genfscon sysfs /devices/system/cpu/cpufreq/policy4/scaling_min_freq u:object_r:vendor_sysfs_cpufreq_limit:s0
genfscon sysfs /devices/system/cpu/cpufreq/policy4/scaling_max_freq u:object_r:vendor_sysfs_cpufreq_limit:s0
genfscon sysfs /devices/system/cpu/cpufreq/policy7/scaling_min_freq u:object_r:vendor_sysfs_cpufreq_limit:s0
genfscon sysfs /devices/system/cpu/cpufreq/policy7/scaling_max_freq u:object_r:vendor_sysfs_cpufreq_limit:s0
# Memory-bus floors the power HAL writes (power.te): the DDR bandwidth
# monitor's and the prime cluster's L3 latency monitor's min_freq.
genfscon sysfs /devices/system/cpu/bus_dcvs/DDR/24091000.qcom,bwmon-ddr/min_freq u:object_r:vendor_sysfs_bus_dcvs_limit:s0
genfscon sysfs /devices/system/cpu/bus_dcvs/L3/soc:qcom,memlat:l3:prime/min_freq u:object_r:vendor_sysfs_bus_dcvs_limit:s0
# USB-C port control: the charger firmware's input suspend, which Off sets
# (usb_port_security.te).
genfscon sysfs /class/qcom-battery/suspend_input_current u:object_r:vendor_sysfs_usb_input_suspend:s0
