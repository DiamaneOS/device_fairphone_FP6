# The Adreno driver runs inside every process that renders. It reads the GPU
# model (same grant as the pinned Qualcomm generic/vendor/common/domain.te)
# and its read-only graphics properties (vendor.gralloc.*,
# ro.vendor.graphics.memory, vendor.debug.egl.*).
allow { domain -isolated_app_all } vendor_sysfs_kgsl:dir search;
allow { domain -isolated_app_all } vendor_sysfs_kgsl_gpu_model:file r_file_perms;
# mediaserver (MediaRecorder/MediaPlayer) also loads the gralloc mapper but is
# left out: the only vendor.gralloc.* value set (disable_ubwc=0) equals the
# mapper's default, so a denied read changes nothing. Add mediaserver here in
# the same change that sets any vendor.gralloc.* property to a non-default
# value, so its buffer layout matches the allocator's.
get_prop({ appdomain -isolated_app_all zygote system_server bootanim surfaceflinger mediaswcodec
           hal_graphics_allocator_default hal_graphics_composer_default }, vendor_gralloc_prop)
get_prop({ appdomain -isolated_app_all zygote system_server bootanim surfaceflinger mediaswcodec
           hal_graphics_allocator_default hal_graphics_composer_default }, vendor_public_vendor_default_prop)

# Composer state in /data/vendor/display (mode merge data), as in stock.
allow hal_graphics_composer_default vendor_display_vendor_data_file:dir create_dir_perms;
allow hal_graphics_composer_default vendor_display_vendor_data_file:file create_file_perms;

# init.qcom.rc hands the panel brightness node to system (composer).
allow init vendor_sysfs_graphics:file setattr;
