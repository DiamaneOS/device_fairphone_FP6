# Scheduler and memory tuning from boot/init.fp6.perf.rc (vendor_init). The
# platform labels none of these sysctls, so they would share the generic proc
# label. Each gets its own type (genfs lines in fp6/genfs_contexts) and only
# vendor_init writes them.
#
# swappiness and min_free_kbytes.
type vendor_proc_vm_tuning, fs_type, proc_type;
# compaction_proactiveness.
type vendor_proc_compaction, fs_type, proc_type;

allow vendor_init { vendor_proc_vm_tuning vendor_proc_compaction }:file write;

# RT throttling window and the RT uclamp default (platform proc_sched).
allow vendor_init proc_sched:file write;
# Reclaim watermark for zram swap (platform proc_watermark_scale_factor).
allow vendor_init proc_watermark_scale_factor:file write;

# Memory-bus DCVS tunables. Their live DDR and L3 frequencies are a side channel,
# so they leave sysfs_devices_system_cpu, which every domain may read. Only
# vendor_init writes them, at boot. No closed vendor binary names them.
type vendor_sysfs_bus_dcvs, fs_type, sysfs_type;
allow vendor_init vendor_sysfs_bus_dcvs:dir search;
allow vendor_init vendor_sysfs_bus_dcvs:file { open write };
neverallow { untrusted_app_all isolated_app_all ephemeral_app } vendor_sysfs_bus_dcvs:file *;
