# Read-only SoC identification and thermal zones.
allow { hal_thermal_default vendor_thermal-engine } vendor_sysfs_soc:dir search;
allow { hal_thermal_default vendor_thermal-engine } vendor_sysfs_public:file r_file_perms;
allow vendor_thermal-engine vendor_sysfs_soc:file r_file_perms;
r_dir_file(hal_thermal_default, sysfs_thermal)

# The peripheral manager maps remote processors by their sysfs names.
r_dir_file({ vendor_per_mgr vendor_per_proxy }, vendor_sysfs_ssr)

# The Wi-Fi HAL switches the QCA6750 driver on through /dev/wlan and
# publishes the driver version, as in stock.
allow hal_wifi_default vendor_wlan_device:chr_file w_file_perms;
set_prop(hal_wifi_default, vendor_wifi_version)
# High-throughput TCP tuning: libwifi-hal saves the TCP small-queue limit, raises
# it on the driver's throughput-change event and restores it. Only this sysctl
# (genfs line in fp6/genfs_contexts), not the rest of /proc/sys/net.
type vendor_proc_tcp_limit_output_bytes, fs_type, proc_type;
allow hal_wifi_default vendor_proc_tcp_limit_output_bytes:file { getattr open read write };

# KeyMint reports the vendor patch level for key attestation.
get_prop(vendor_hal_keymint_qti, vendor_security_patch_level_prop)

# The USB HAL reads the negotiated USB speed.
allow vendor_hal_usb_qti sysfs_udc:dir search;
allow vendor_hal_usb_qti sysfs_udc:file r_file_perms;

# Vendor init scripts set these vendor properties.
set_prop(vendor_init, vendor_gralloc_prop)
set_prop(vendor_init, vendor_display_prop)
set_prop(vendor_init, vendor_usb_prop)
set_prop(vendor_init, vendor_disable_spu_prop)
# Our audio.mk and telephony.mk properties, and persist.vendor.ssr.restart_level
# (modem.mk), without which a modem or DSP crash panics the phone instead of
# restarting that subsystem. Under enforcing, init drops lines it may not set.
set_prop(vendor_init, vendor_audio_prop)
set_prop(vendor_init, vendor_radio_prop)
set_prop(vendor_init, vendor_ssr_prop)
# persist.vendor.data.profile_update (telephony.mk): QCRIL copies Android's
# APNs into the modem's data profiles.
set_prop(vendor_init, vendor_dataqdp_prop)
# persist.vendor.sensors.enable.mag_filter and support_direct_channel
# (device.mk), as stock.
set_prop(vendor_init, vendor_sensors_prop)
