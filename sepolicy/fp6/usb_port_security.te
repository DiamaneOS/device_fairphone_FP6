# USB-C port control. The dwc3-msm controller's dynamic_disable node turns USB
# data off and on; charging is not affected. It gets its own type (its line in
# vendor-common/genfs_contexts) instead of vendor_sysfs_usb_device, which also
# covers the controller role (mode) and other USB nodes.
#
# vendor_init writes it from the sys.port_security_mode triggers in
# boot/init.qcom.usb.rc. The platform already lets vendor_init and ueventd write
# every sysfs_type file; the rule below states the one vendor_init needs here.
# The Qualcomm USB HAL gets no write: with port control on
# (config_usbPortSecuritySupported), the framework turns enableUsbData requests
# (Lockdown, device policy) into port states and never passes them to the HAL,
# its only writer of this node. So a compromised HAL cannot turn data back on
# while the phone is locked.
type vendor_sysfs_usb_data_disable, sysfs_type, fs_type;

allow vendor_init vendor_sysfs_usb_data_disable:file { open write };

# Nothing else may write it: a later rule that adds a writer fails the build.
neverallow {
  domain
  -vendor_init
  -ueventd
} vendor_sysfs_usb_data_disable:file { write append };

# Off also suspends the charger input in the ADSP charger firmware:
# /sys/class/qcom-battery/suspend_input_current, a class attribute of
# qti_battery_charger (its line in fp6/genfs_contexts; it had the generic
# sysfs label). 1 stops the phone drawing current from the port, 0 resumes.
# vendor_init writes it from the same triggers, at boot, in charger mode and
# at shutdown. No service uses it.
type vendor_sysfs_usb_input_suspend, sysfs_type, fs_type;

allow vendor_init vendor_sysfs_usb_input_suspend:file { open write };

# Nothing else may write it: a later rule that adds a writer fails the build.
neverallow {
  domain
  -vendor_init
  -ueventd
} vendor_sysfs_usb_input_suspend:file { write append };
