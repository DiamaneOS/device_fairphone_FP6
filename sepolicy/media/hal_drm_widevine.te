# Widevine DRM HAL from Fairphone's stock package (vendor APEX
# com.google.android.widevine; the files inside it carry their own labels,
# hal_drm_widevine_exec for the service), with the stock hardware-backed
# library (liboemcrypto.so), which talks to the Widevine trusted application.
# The grant on the TEE node is in fp6/tee_node.te.
#
# Written for this product, not imported. Of the stock Qualcomm rule set
# (generic/vendor/common/hal_drm_widevine.te) it leaves out the vendor binder
# and display service rules, which the library does not use, and the wake
# lock rules.
type hal_drm_widevine, domain;
type hal_drm_widevine_exec, exec_type, vendor_file_type, file_type;

hal_server_domain(hal_drm_widevine, hal_drm)
init_daemon_domain(hal_drm_widevine)

# Its certificates, licences and usage records (/data/vendor/mediadrm).
allow hal_drm_widevine vendor_mediadrm_vendor_data_file:dir create_dir_perms;
allow hal_drm_widevine vendor_mediadrm_vendor_data_file:file create_file_perms;

# The library's working buffers shared with the trusted application come from
# the QSEECom heap, as KeyMint's do.
allow hal_drm_widevine vendor_dmabuf_qseecom_heap_device:chr_file r_file_perms;

# qseecomd's socket, over which the library announces itself to the daemon's
# listeners.
allow hal_drm_widevine vendor_notify-topology_socket:sock_file write;
allow hal_drm_widevine tee:unix_stream_socket connectto;

# The crypto engine node, for content the licence lets it decrypt into
# ordinary memory.
allow hal_drm_widevine vendor_qce_device:chr_file { open read write ioctl };

# The library asks for the display configuration service to choose a resource
# tier and uses the same tier when it gets no answer. Not granted.
dontaudit hal_drm_widevine vendor_hal_vnddisplayconfig_service:service_manager find;
