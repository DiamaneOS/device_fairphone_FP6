# Widevine DRM HAL from Fairphone's stock package (vendor APEX
# com.google.android.widevine, whose files carry their own labels,
# hal_drm_widevine_exec for the service), with its built-in software
# protection only (media/init.fp6.drm.rc).
#
# Written for this product, not imported. Nothing of the stock Qualcomm rule
# set (generic/vendor/common/hal_drm_widevine.te) for the hardware-backed
# library is granted: no rule here or in fp6/tee_node.te lets it use the TEE
# node, the QSEECom heap, the crypto engine node, qseecomd's socket, the
# memory-buffer driver and its bitstream node, or the codec service's file
# descriptors.
type hal_drm_widevine_sw, domain;
type hal_drm_widevine_exec, exec_type, vendor_file_type, file_type;

hal_server_domain(hal_drm_widevine_sw, hal_drm)
# init_daemon_domain(), for the executable type the package's own labels use.
domain_auto_trans(init, hal_drm_widevine_exec, hal_drm_widevine_sw)

# Its certificates, licences and usage records (/data/vendor/mediadrm).
allow hal_drm_widevine_sw vendor_mediadrm_vendor_data_file:dir create_dir_perms;
allow hal_drm_widevine_sw vendor_mediadrm_vendor_data_file:file create_file_perms;
