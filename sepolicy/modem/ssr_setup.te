# Reduced by DiamaneOS from Qualcomm generic/vendor/common/ssr_setup.te
# (sepolicy_vndr 67fa928299a49374a55281969fee357884c86890): the processor links
# and names are read-only, and the vendor_sysfs_data read is left out. Scope
# and omitted stock grants are documented in sepolicy/README.md (Modem).

# Required to enable/disable ssr
type vendor_ssr_setup, domain;
type vendor_ssr_setup_exec, exec_type, vendor_file_type, file_type;

init_daemon_domain(vendor_ssr_setup)

# List /sys/class/remoteproc, follow its links and read each processor's name.
r_dir_file(vendor_ssr_setup, vendor_sysfs_ssr)

# Write "enabled"/"disabled" to /sys/.../remoteproc/remoteprocN/recovery.
allow vendor_ssr_setup vendor_sysfs_ssr_toggle:file rw_file_perms;

# persist.vendor.ssr.restart_level
get_prop(vendor_ssr_setup, vendor_ssr_prop)

# Enforcing follow-up (not granted; permissive bring-up): the ro.arch read,
# libmdmdetect's probes of the absent /sys/bus/esoc and /sys/bus/msm_subsys,
# and traversal of the /sys/devices/platform/soc/<rproc>/remoteproc/ dirs.
# Grant only what the r9p denial log shows.
