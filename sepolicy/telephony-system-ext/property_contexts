# Read by the framework's ServiceStateTracker (com.android.phone) and set from
# vendor build.prop (telephony/telephony.mk). Without this label init drops the
# vendor build.prop line under enforcing SELinux.
ro.telephony.network_state_poll_window_ms u:object_r:telephony_config_prop:s0 exact int

# Android 17 Build.VERSION reads this when the class loads. The platform
# leaves it in default_prop, which non-coredomain vendor apps cannot read. Use
# the existing public build-property type, matching ro.build.version.sdk.
# Never grant apps access to default_prop. GrapheneOS labels
# ro.build.version.sdk_full and release_or_preview_display itself.
ro.build.version.known_codenames u:object_r:build_prop:s0 exact string
