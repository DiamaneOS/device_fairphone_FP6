# Copyright 2026 The DiamaneOS Project
# nicmd (network interface control manager) configures the rmnet data
# interfaces for modem data calls. Start as radio from exec, so threads created
# before the closed library's privilege-drop call cannot remain root. The
# rendered service retains only NET_ADMIN, NET_RAW and BLOCK_SUSPEND. Reduced from
# Qualcomm sepolicy_vndr @ 67fa928299a49374a55281969fee357884c86890
# generic/vendor/common/nicmd.te. Omitted: the SHS,
# QMI-priority and performance helpers (shsusrd, qmipriod, perf HAL and their
# properties), the legacy MSM IPC-router socket and ioctls, the HIDL
# netd service (the daemon links only the AIDL netd interface), diag, the
# netdomain attribute (stock vendor_sepolicy.cil line 442; it would add TCP
# connect and name_bind on every port, which nicmd does not use: besides
# interface ioctls it only binds ephemeral ports for the modem, node_bind
# below) and write access to /data/vendor/nicmd beyond the init-created
# recovery file (the file log is off, nicm_config.xml rewrite).
type vendor_nicmd, domain;
type vendor_nicmd_exec, exec_type, vendor_file_type, file_type;
init_daemon_domain(vendor_nicmd)

# Control socket (/dev/socket/nicmd) and recovery state
# (/data/vendor/nicmd/nicm_recovery, created by nicmd.rc).
allow vendor_nicmd vendor_nicmd_socket:dir w_dir_perms;
allow vendor_nicmd vendor_nicmd_socket:sock_file create_file_perms;
allow vendor_nicmd vendor_nicm_data_file:dir search;
allow vendor_nicmd vendor_nicm_data_file:file rw_file_perms;

# rmnet links, addresses, routes and xfrm; modem data-call events over QRTR;
# interface ioctls on datagram sockets (stock vendor_sepolicy.cil 6082-6085).
allow vendor_nicmd self:udp_socket create_socket_perms;
allow vendor_nicmd self:tcp_socket create_socket_perms_no_ioctl;
allow vendor_nicmd self:netlink_route_socket { create_socket_perms_no_ioctl nlmsg_read nlmsg_write };
# Wi-Fi calling through the modem: the modem negotiates the ePDG tunnel and
# hands nicmd the ESP security associations (QMI WDS IPsec SA indications,
# libnicm_modemproxy installSecurity), which nicmd installs in the kernel so
# the tunnel runs over the phone's Wi-Fi (libnicm_netlink XFRMHelper.cpp:
# NEWSA, NEWPOLICY, DELSA and DELPOLICY requests, nlmsg_write). To remove them
# at teardown and rekey it sends a GETSA dump (NLM_F_DUMP, nlmsg_read) and
# deletes the states whose protocol and SPI match (removeXFRMStateCb); it
# sends no other read request. Without nlmsg_read the old states would stay
# after a rekey or teardown. The dump returns every security association, not
# only nicmd's own, with its keys zeroed (lockdown and the kernel's own XFRM
# redaction). Stock grants the same (vendor_sepolicy.cil 6074).
allow vendor_nicmd self:netlink_xfrm_socket { create_socket_perms_no_ioctl nlmsg_write nlmsg_read };
allow vendor_nicmd self:netlink_generic_socket create_socket_perms_no_ioctl;
allow vendor_nicmd self:netlink_socket create_socket_perms_no_ioctl;
allow vendor_nicmd self:qipcrtr_socket create_socket_perms_no_ioctl;
# The data module's interface requests arrive over TIPC (libnicm
# EventTIPCMessenger/RequestTIPCMessenger; stock vendor_sepolicy.cil line 6080).
allow vendor_nicmd self:tipc_socket { create_socket_perms_no_ioctl listen accept };
allowxperm vendor_nicmd self:udp_socket ioctl priv_sock_ioctls;
allowxperm vendor_nicmd self:udp_socket ioctl rmnet_sock_ioctls;
# Modem remote-socket port reservation (libnicm_modemproxy reservePorts): nicmd
# binds the ephemeral TCP/UDP ports the modem's embedded clients use, so AP
# traffic cannot take them. No name_bind (ephemeral ports only), no listen.
allow vendor_nicmd node:{ tcp_socket udp_socket } node_bind;
allow vendor_nicmd self:capability { net_admin net_raw };
neverallow vendor_nicmd self:capability { setgid setpcap setuid kill };
wakelock_use(vendor_nicmd)
dontaudit vendor_nicmd kernel:system { module_request };

# Network tuning knobs.
allow vendor_nicmd sysfs_net:dir r_dir_perms;
allow vendor_nicmd sysfs_net:file rw_file_perms;
allow vendor_nicmd proc_net:file rw_file_perms;
allow vendor_nicmd vendor_sysfs_data:file r_file_perms;
get_prop(vendor_nicmd, boot_status_prop)

# Mobile data target detection (libdsutils ds_get_target, ds_get_soc_id): with
# only the internal modem, the target comes from the public SoC id (636 ->
# lanai). Not granted: /sys/class/remoteproc (vendor_sysfs_ssr), which
# libmdmdetect probes for external/fusion modems only; one denial per start.
allow vendor_nicmd vendor_sysfs_soc:dir search;
allow vendor_nicmd vendor_sysfs_public:file { open read getattr };

# ip/iptables through the platform wrappers (/system/bin/ip-wrapper-1.0).
use_netutils(vendor_nicmd)
allow vendor_nicmd netutils_wrapper:process sigkill;

# netd (android.system.net.netd AIDL) and the connectivity native service.
binder_call(vendor_nicmd, netd)
binder_call(vendor_nicmd, servicemanager)
allow vendor_nicmd system_net_netd_service:service_manager find;
allow vendor_nicmd connectivity_native_service:service_manager find;
binder_call(vendor_nicmd, system_server)
