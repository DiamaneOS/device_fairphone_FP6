# timekeepd (timekeep/) keeps the system clock across reboots on top of the
# read-only PMIC RTC. Two services run the same binary (timekeepd.rc):
# - vendor.timekeepd-restore (vendor_timekeepd_restore) sets the clock once at
#   post-fs-data from the RTC counter plus the saved offset, then exits;
# - vendor.timekeepd (vendor_timekeepd) keeps running and saves the offset
#   whenever the clock changes. It cannot set the clock.
# They replace Qualcomm's time_daemon (not installed; its imported policy is
# removed), which also held CAP_SYS_TIME but spoke QMI to the modem, wrote
# persist and the SMEM log and served libtime_genoff clients. None of that is
# granted here: no sockets, binder, properties, /dev/rtc0 or persist.
type vendor_timekeepd, domain;
type vendor_timekeepd_restore, domain;
type vendor_timekeepd_exec, exec_type, vendor_file_type, file_type;
init_daemon_domain(vendor_timekeepd)
# The restore service enters its domain through its seclabel.
domain_trans(init, vendor_timekeepd_exec, vendor_timekeepd_restore)

# Set CLOCK_REALTIME: the restore service's only capability (timekeepd.rc).
# The long-running service has none.
allow vendor_timekeepd_restore self:capability sys_time;
neverallow vendor_timekeepd_restore self:capability ~sys_time;
neverallow vendor_timekeepd self:capability *;
neverallow { vendor_timekeepd vendor_timekeepd_restore } self:capability2 *;

# The RTC counter, /sys/class/rtc/rtc0/since_epoch. The class directory is the
# platform's sysfs_rtc; the rtc0 link and the device directories are sysfs,
# which every domain may follow and search. Only the counter file gets this
# type (genfs_contexts); the RTC's alarm and other attributes keep their
# generic label and stay out of reach.
type vendor_sysfs_rtc_counter, sysfs_type, fs_type;
allow { vendor_timekeepd vendor_timekeepd_restore } sysfs_rtc:dir search;
allow { vendor_timekeepd vendor_timekeepd_restore } vendor_sysfs_rtc_counter:file { open read };

# The saved offset, /data/vendor/timekeepd/offset. vendor_init creates the
# directory. The daemon replaces the file through a temporary file and rename,
# then syncs the directory (open, read) so the rename survives a power loss.
# The restore service only reads it.
type vendor_timekeepd_data_file, file_type, data_file_type;
allow vendor_timekeepd vendor_timekeepd_data_file:dir { open read search write add_name remove_name };
allow vendor_timekeepd vendor_timekeepd_data_file:file { create open read write rename unlink };
allow vendor_timekeepd_restore vendor_timekeepd_data_file:dir search;
allow vendor_timekeepd_restore vendor_timekeepd_data_file:file { open read };

# The offset decides the clock at every boot: no other vendor service may
# change it or the directory holding it.
neverallow { domain -coredomain -vendor_init -vendor_timekeepd } vendor_timekeepd_data_file:file { create write append rename unlink link setattr relabelto };
neverallow { domain -coredomain -vendor_init -vendor_timekeepd } vendor_timekeepd_data_file:dir { add_name remove_name rename reparent rmdir write };
