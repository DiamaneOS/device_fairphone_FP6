<?xml version="1.0" encoding="utf-8"?>
<!--
     SPDX-License-Identifier: Apache-2.0
     Copyright 2026 The DiamaneOS Project

     Default component state of the stock eSIM LPA. SystemConfig
     "component-override" sets the default enabled state of components of a
     preinstalled package (ScanPackageUtils.configurePackageComponents); a later
     user choice overrides it and persists.

     QtiEuiccServiceImpl, the EuiccService, is on (its manifest default; owner
     decision of 26 September 2026). Without it Android finds no LPA: it cannot
     tell that a profile is an eSIM, switching an eSIM off drops it from
     Settings with no way back, and a factory reset cannot erase eSIM profiles.
     There is still no download screen, so adding an eSIM is not possible yet.

     UimLpaService: a service for Qualcomm's own LPA UI apps, which are not
       installed. QtiEuiccServiceImpl does not bind it. It stays disabled.
-->
<config>
    <component-override package="com.qualcomm.qti.lpa">
        <component class="com.qualcomm.qti.lpa.UimLpaService" enabled="false"/>
    </component-override>
</config>
