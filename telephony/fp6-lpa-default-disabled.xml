<?xml version="1.0" encoding="utf-8"?>
<!--
     SPDX-License-Identifier: Apache-2.0
     Copyright 2026 The DiamaneOS Project

     The stock eSIM LPA stays off until the user turns eSIM on. SystemConfig
     "component-override" sets the default enabled state of these components
     of a preinstalled package (ScanPackageUtils.configurePackageComponents);
     a later user or shell choice (pm enable) overrides the default and
     persists.

     QtiEuiccServiceImpl: the EuiccService. While it is disabled the framework
       finds no LPA, and the app is never started (it has no activity or
       receiver).
     UimLpaService: a service for Qualcomm's own LPA UI apps, which are not
       installed. QtiEuiccServiceImpl does not bind it. It stays disabled.

     To turn eSIM on (r9p, until a Settings switch exists), then reboot:
       adb shell pm enable com.qualcomm.qti.lpa/com.qualcomm.qti.lpa.QtiEuiccServiceImpl
-->
<config>
    <component-override package="com.qualcomm.qti.lpa">
        <component class="com.qualcomm.qti.lpa.QtiEuiccServiceImpl" enabled="false"/>
        <component class="com.qualcomm.qti.lpa.UimLpaService" enabled="false"/>
    </component-override>
</config>
