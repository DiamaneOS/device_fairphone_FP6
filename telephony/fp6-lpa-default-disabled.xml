<!--
     SPDX-License-Identifier: Apache-2.0
     Copyright 2026 The DiamaneOS Project

     DiamaneOS turns the stock eSIM LPA's services off by default. Stock does
     not: its manifest enables QtiEuiccServiceImpl and no stock file overrides
     that. SystemConfig "component-override" sets the default enabled state of
     these components of a preinstalled package
     (ScanPackageUtils.configurePackageComponents); a later user or shell
     choice (pm enable) overrides the default and persists.

     QtiEuiccServiceImpl: the EuiccService. It cannot list profiles on the FP6
       (the stock radio daemon cannot decode the modem's reply), so Android
       would treat an eSIM as a physical SIM. While it is disabled the
       framework finds no LPA and the app is never started (it has no
       activity or receiver); installed eSIM profiles keep working as SIMs.
       Its JNI library is not installed, so enabling it by hand makes the app
       crash.
     UimLpaService: a service for Qualcomm's own LPA UI apps, which are not
       installed. QtiEuiccServiceImpl does not bind it. It stays disabled.
-->
<config>
    <component-override package="com.qualcomm.qti.lpa">
        <component class="com.qualcomm.qti.lpa.QtiEuiccServiceImpl" enabled="false"/>
        <component class="com.qualcomm.qti.lpa.UimLpaService" enabled="false"/>
    </component-override>
</config>
