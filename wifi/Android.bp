// A namespace of its own, so other products (such as the generic one the vendor
// step builds host tools for) do not install this file over their own.
soong_namespace {
}

// The supplicant copies this template to /data/vendor/wifi/wpa on first use.
// Generated from wpa_supplicant_8's own template, as AOSP does.
prebuilt_etc {
    name: "fp6_wpa_supplicant_conf",
    src: ":wpa_supplicant_conf_gen",
    filename: "wpa_supplicant.conf",
    sub_dir: "wifi",
    vendor: true,
    licenses: ["external_wpa_supplicant_8_license"],
}
